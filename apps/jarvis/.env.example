# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JARVIS_AUTH_TOKEN=
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis-local-only@127.0.0.1:5432/jarvis
JARVIS_PROVIDER=fake
OPENAI_API_KEY=
JARVIS_PRIMARY_REASONING_MODEL=gpt-6-astra
JARVIS_FALLBACK_REASONING_MODEL=gpt-6.1-sol
JARVIS_UTILITY_MODEL=
JARVIS_VOICE_MODEL=gpt-live-1
JARVIS_EMBEDDING_MODEL=
JARVIS_EMBEDDING_PROVIDER=fake
JARVIS_EMBEDDING_DIMENSIONS=64
JARVIS_MEMORY_PGVECTOR=false
JARVIS_MEMORY_CONTEXT_TOKENS=4000
JARVIS_CONTEXT_TOKEN_BUDGET=24000
JARVIS_ALLOW_FALLBACK=false
# Trusted operator registrations; project IDs, never paths, are accepted by tools.
JARVIS_PROJECT_ROOTS={"graphify":"../.."}
JARVIS_CAPABILITIES=["graph.read","graph.write","workspace.read","memory.read","memory.write","memory.propose"]
